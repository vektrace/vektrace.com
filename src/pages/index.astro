---
import "../styles/global.css";
import Footer from "../components/Footer.astro";
import Card from "../components/Card.astro";
import Layout from "../layouts/Layout.astro";
---
<Layout title="Vektrace" desc="Explore games and other software by Vektrace. Discover open-source tools and software made in Rust." favicon="/favicon.png">
    <main class="min-h-dvh flex flex-col pt-15 pb-32 bg-black bg-linear-120 from-[#00312e] via-transparent to-[#002b00]">
        <div class="text-center mb-12.5">
            <h1 class="text-white text-5xl mb-3.75 font-medium">Vektrace</h1>
            <p class="text-neutral-400 text-xl">I create games and other software</p>
        </div>
        <h2 class="text-center text-white font-medium text-3xl mb-6">Explore</h2>
        <div class="grid md:grid-cols-3 gap-5 m-5">
            <Card title="Projects" body="My Games and Software" link="/projects" />
            <Card title="About" body="General information about me" link="/about" />
        </div>

        <div class="flex justify-center mt-auto px-5 pt-12 pb-6">
            <div class="flex flex-wrap items-center justify-center gap-3 px-6 py-3 bg-black/25 backdrop-blur-md border-2 border-white/20 rounded-4xl">
                <img src="/88x31/vktrc.png" alt="VKTRC 88x31 Button" width="88" height="31" />
                <a href="https://cansynapseinviteyet.codeberg.page/" target="_blank">
                    <img src="https://cansynapseinviteyet.codeberg.page/cansynapseinviteyet-88x31.webp" alt="Can Synapse invite yet?" width="88" height="31" />
                </a>
                <a href="https://gingershaped.computer/" target="_blank">
                    <img src="https://gingershaped.computer/8831/button.png" alt="ginger's 88x31 button" width="88" height="31" />
                </a>
                <a href="https://www.31a05b.net" target="_blank">
                    <img src="https://www.31a05b.net/a/8831/31a05b.png" alt="rings of particles around disc; cat emoticons" width="88" height="31">
                </a>
            </div>
        </div>
        <Footer />
    </main>
</Layout>
